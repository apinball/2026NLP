HF_NER_MODEL_KO=monologg/koelectra-base-v3-finetuned-naver-ner
HF_NER_MODEL_EN=dslim/bert-base-NER
HF_PPL_MODEL=skt/kogpt2-base-v2

# HF Hub 인증 — 모델 다운로드 속도·안정성 향상
# https://huggingface.co/settings/tokens → Create new token (read 권한)
HF_TOKEN=

# LLM API keys — 어댑터를 골라서 사용. 셋 다 채울 필요 없음
# Ollama 로컬은 키 불필요 (docker compose up -d ollama)
GROQ_API_KEY=
GEMINI_API_KEY=
